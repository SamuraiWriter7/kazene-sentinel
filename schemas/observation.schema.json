{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAZENE-Sentinel Observation Record",
  "description": "Observation record schema for KAZENE-Sentinel Protocol v0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "timestamp",
    "source",
    "status",
    "reason",
    "evidence",
    "escalation_required",
    "execution_authorized"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Unique observation identifier within the validation dataset."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC observation timestamp in YYYY-MM-DDTHH:MM:SSZ format."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Source of the observation."
    },
    "status": {
      "type": "string",
      "enum": [
        "NORMAL",
        "ANOMALY",
        "UNKNOWN"
      ],
      "description": "Classification of the observed condition."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Explanation of the observation classification."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "References to supporting observation evidence."
    },
    "escalation_required": {
      "type": "boolean",
      "description": "Whether notification to an external reasoning or decision layer is required."
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false,
      "description": "Sentinel must never grant execution authority."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NORMAL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "escalation_required": {
            "const": false
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ANOMALY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "escalation_required": {
            "const": true
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "escalation_required": {
            "type": "boolean"
          },
          "evidence": {
            "minItems": 0
          }
        }
      }
    }
  ]
}
